{
	"name": "@tartan/web",
	"version": "0.1.0",
	"description": "The Tartan forge's web interface: orgs, repositories, issues and Kanban boards over the gateway API.",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"prepare": "panda codegen",
		"predev": "panda codegen",
		"dev": "astro dev",
		"prebuild": "panda codegen",
		"build": "astro build",
		"preview": "astro preview",
		"precheck": "panda codegen",
		"check": "astro check && vue-tsc --noEmit -p tsconfig.json",
		"pretest": "panda codegen",
		"test": "vitest run"
	},
	"dependencies": {
		"@astrojs/vue": "7.1.2",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"astro": "7.4.7",
		"dompurify": "3.4.17",
		"marked": "18.1.3",
		"vue": "3.5.45",
		"vue-router": "5.4.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@pandacss/dev": "2.5.0",
		"@pandacss/preset-base": "2.5.0",
		"@pandacss/preset-panda": "2.5.0",
		"@pandacss/vite": "2.5.0",
		"@vue/test-utils": "2.5.1",
		"happy-dom": "21.0.4",
		"postcss": "8.5.32",
		"typescript": "6.0.3",
		"vitest": "5.1.0",
		"vue-tsc": "3.3.14"
	}
}
