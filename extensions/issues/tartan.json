{
	"schema": 1,
	"id": "rawkode.issues",
	"name": "Issues",
	"description": "Per-repository issues, optionally filed against a project; every write emits the issue as x.rawkode.issues.issue.created or .updated, so other extensions can build on them",
	"version": "0.5.0",
	"api": "tartan:ext@0.1.0",
	"runtime": "wasm",
	"storage": {
		"scope": "repo",
		"migrations": [
			"migrations/0001_init.sql",
			"migrations/0002_project.sql",
			"migrations/0003_fields.sql"
		]
	},
	"permissions": {},
	"contributes": {
		"slots": [
			{
				"slot": "repo.tab",
				"id": "issues",
				"label": "Issues",
				"route": "issues",
				"when": "node.kind == 'repo'",
				"role": 20
			}
		],
		"tools": [
			{
				"name": "list",
				"description": "List the repository's issues, newest first, without their bodies; with project, only that project's.",
				"input": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"state": {
							"type": "string",
							"enum": [
								"open",
								"closed",
								"all"
							],
							"default": "open",
							"description": "Which issues to list (default open)"
						},
						"limit": {
							"type": "integer",
							"minimum": 1,
							"maximum": 100,
							"default": 30
						},
						"project": {
							"type": "string",
							"minLength": 1,
							"maxLength": 512,
							"description": "Only this project's issues: a root path (crates/lsp), as the kernel passes it"
						},
						"before": {
							"type": "integer",
							"minimum": 1,
							"maximum": 2147483647,
							"description": "Only issues numbered below this: the previous page's nextBefore"
						}
					}
				},
				"role": 20,
				"export": "issues@1",
				"access": "read",
				"output": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"state",
						"project",
						"issues",
						"open",
						"closed",
						"fields",
						"nextBefore"
					],
					"properties": {
						"state": {
							"enum": [
								"open",
								"closed",
								"all"
							]
						},
						"project": {
							"type": [
								"string",
								"null"
							]
						},
						"issues": {
							"type": "array",
							"items": {
								"type": "object",
								"additionalProperties": false,
								"required": [
									"number",
									"title",
									"project",
									"state",
									"author",
									"createdAt",
									"updatedAt",
									"closedAt",
									"fields",
									"version"
								],
